<h1><%= job ? 'Edit' : 'Add' %> Job</h1>

<form action="<%= job ? '/jobs/update/' + job._id : '/jobs' %>" method="POST">
  <div>
    <label for="title">Title</label>
    <input type="text" name="title" value="<%= job ? job.title : '' %>" required />
  </div>

  <div>
    <label for="description">Description</label>
    <textarea name="description" required><%= job ? job.description : '' %></textarea>
  </div>

  <div>
    <label for="salary">Salary</label>
    <input type="number" name="salary" value="<%= job ? job.salary : '' %>" required />
  </div>

  <button type="submit"><%= job ? 'Update' : 'Create' %> Job</button>
</form>

<a href="/jobs">Back to Job List</a>
