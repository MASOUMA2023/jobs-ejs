<h1 class="edit-job-header">Edit Job</h1>
<style>
  body {
    background-color: lightblue;
    font-family: Arial, sans-serif;
  }
.edit-job-container {
  max-width: 600px;
  margin: 0 auto;
  background-color: #f9f9f9d4;
  padding: 30px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.edit-job-header {
  color: #333;
  font-size: 2em;
  text-align: center;
  margin-bottom: 20px;
}

.edit-job-form {
  display: flex;
  flex-direction: column;
}

.edit-job-form label {
  margin-bottom: 8px;
  font-weight: bold;
}
.edit-job-form button {
  text-decoration: none;
    background-color: #28a745;
    color: white;
  font-weight: bold;
}
</style>
<div class="edit-job-container">
<form class="edit-job-form" action="/jobs/update/<%= job._id %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div>
    <label for="position">Job Title</label>
    <input type="text" name="position" value="<%= job.position %>" required />
  </div>

  <div>
    <label for="company">Company</label>
    <textarea name="company" required><%= job.company %></textarea>
  </div>

  <div>
    <button type="submit">Update Job</button>
  </div>
</form>
</div>
